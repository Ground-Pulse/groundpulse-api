# Application
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5000/groundpulse?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT
JWT_SECRET="groundpulse_super_secret_jwt_key_development_2026"
JWT_EXPIRES_IN="15m"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
CORS_ORIGIN="http://localhost:3000"

# AWS S3 / File Storage (Optional / Production)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock-key-id"
AWS_SECRET_ACCESS_KEY="mock-secret-key"
AWS_S3_BUCKET_NAME="groundpulse-reports"
